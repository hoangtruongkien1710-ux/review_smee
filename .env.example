# ====== Smee Review - cấu hình ======
# Sao chép file này thành ".env" (cùng thư mục) rồi sửa các giá trị.
# Không có file .env thì app vẫn chạy được với giá trị mặc định (chỉ nên dùng để thử trên máy).

# Cổng mở trên máy/VPS. Trên VPS muốn vào bằng http://<IP-VPS> thì đặt 80.
APP_PORT=3000

# Địa chỉ app mà người dùng gõ vào trình duyệt
APP_URL=http://localhost:3000
# Khi có tên miền: DOMAIN=review.smee.vn và APP_URL=https://review.smee.vn (xem docs/ten-mien.md)
# DOMAIN=

# Mật khẩu database PostgreSQL. ĐỔI trước khi chạy lần đầu trên VPS (đổi sau sẽ phải tạo lại DB).
POSTGRES_PASSWORD=doi-mat-khau-nay

# Số file worker xử lý cùng lúc (VPS 10 CPU: để 2-3)
WORKER_CONCURRENCY=2
# Số trang tối đa đổi thành ảnh để xem/comment (PDF, Word…)
MAX_PDF_PAGES=300

# ====== Telegram - xem docs/telegram.md ======
# Token bot lấy từ @BotFather (giữ bí mật)
# TELEGRAM_BOT_TOKEN=
# Nhóm Telegram nhận bản tin comment. Thêm bot vào nhóm, gõ /id trong nhóm để lấy số này.
# TELEGRAM_GROUP_CHAT_ID=
# Nhóm nhận bản tin gộp: gửi khi đã 10 phút không có comment mới, chậm nhất 60 phút
# TELEGRAM_DIGEST_QUIET_MIN=10
# TELEGRAM_DIGEST_MAX_MIN=60

# ====== Google Drive (lưu file gốc) - xem docs/google-drive.md ======
# Để trống thì file gốc giữ trên ổ VPS.
GOOGLE_DRIVE_ROOT_FOLDER_ID=1RrmAoaGS5ufRVFKcBR4SE2RO1Q84dwGU

# Cách dễ nhất - thư mục nằm trong "Drive của tôi": Apps Script (mã ở docs/apps-script.gs)
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/..../exec
# GOOGLE_APPS_SCRIPT_KEY=ma-bi-mat-giong-trong-script

# Cách 1 - thư mục nằm trong Shared Drive: đặt file JSON của service account vào thư mục "secrets"
# GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/google-service-account.json

# Cách 2 - thư mục nằm trong "Drive của tôi": dùng tài khoản công ty riêng (OAuth)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
